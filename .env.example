# Server Configuration
PORT=3000

# Google Sheets Configuration
# 1. Google Spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# 2. Authentication Option A: Path to Service Account JSON Key File
# (Recommended for local running or self-hosted servers)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# 3. Authentication Option B: Direct Environment Variables
# (Ideal for cloud hosting platforms like Render, Railway, Heroku, Vercel)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIB...your private key here...\n-----END PRIVATE KEY-----\n"

